# ---------------------------------------------------------------------------
# Windows / macOS filesystem metadata
# Every file in this repo was transferred from a Windows machine and arrived
# with an NTFS "Zone.Identifier" alternate-data-stream sidecar named
# "<original file>:Zone.Identifier".  They carry no project information.
# ---------------------------------------------------------------------------
*:Zone.Identifier
*:Zone.Identifier:*
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Hadoop / Spark output markers (Windows-safe copies add a checksum
# sidecar for every part file: ".part-00000-...parquet.crc")
# ---------------------------------------------------------------------------
_SUCCESS
*.crc

# ---------------------------------------------------------------------------
# Local environment / package installation (not project source)
# ---------------------------------------------------------------------------
.pylibs/
.venv/
.tmp/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Generated caches (regenerable with preprocess.py in ~1 minute)
# ---------------------------------------------------------------------------
artifacts/
# V2 overlay (meta.json + stats.json, a few KB).  Excluded for the same reason
# as artifacts/: it only describes a cache that is itself not committed, and
# `preprocess.py --feature-set v2 --reuse artifacts --out artifacts_v2`
# rebuilds it in about 20 s.
artifacts_v2/

# ---------------------------------------------------------------------------
# Files larger than 100 MB -> excluded from Git
#   .pylibs/torch/lib/torch_cpu.dll                     250.5 MB
#   runs/full3/best.pt                                  234.2 MB
#   runs/full_tmlp/best.pt                              234.5 MB
#   runs/ablate_all/best.pt                             234.2 MB
#   runs/ablate_none/best.pt                            234.0 MB
#   runs/ablate_numeric/best.pt                         234.2 MB
# ---------------------------------------------------------------------------
runs/**/*.pt
runs/**/*.pth

# Derived prediction tensors (small, but reproducible from checkpoints)
runs/**/*.npz

# GPU_RUNBOOK execution artifacts intentionally published via Git LFS.
!runs/gpu_ref_base/best.pt
!runs/gpu_ref_base/val_preds.npz
!runs/gpu_ref_tmlp/best.pt
!runs/gpu_ref_tmlp/val_preds.npz
!runs/gpu_ref_stack/val_preds.npz
!runs/gpu_ord/best.pt
!runs/gpu_ord/val_preds.npz
!runs/gpu_film/best.pt
!runs/gpu_film/val_preds.npz
!runs/gpu_ord_film/best.pt
!runs/gpu_ord_film/val_preds.npz

# ---------------------------------------------------------------------------
# Datasets: large Spark parquet output is not committed.
# Keep only the small JSON summaries.
#   Task2_OriginData/output/            original Part-A handover (2.16 GB)
#   Task2_Token_Dataset/tokenized/       re-tokenised feature dataset (2.02 GB)
# ---------------------------------------------------------------------------
Task2_OriginData/output/*
!Task2_OriginData/output/*.json
Task2_Token_Dataset/tokenized/*
!Task2_Token_Dataset/tokenized/*.json

# ---------------------------------------------------------------------------
# Generic large archives (also catches future data drops)
# ---------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
